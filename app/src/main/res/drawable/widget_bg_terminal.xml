<?xml version="1.0" encoding="utf-8"?>
<!-- Retro terminal: the slightly domed dark glass of a CRT. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:type="radial"
        android:gradientRadius="70%p"
        android:centerX="0.5"
        android:centerY="0.45"
        android:startColor="#FF0C1A0C"
        android:endColor="#FF030703" />
    <stroke
        android:width="2dp"
        android:color="#FF1F2B1F" />
</shape>
