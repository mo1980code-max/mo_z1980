<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#FF2B2B2B" android:endColor="#FF161616" />
        </shape>
    </item>
    <!-- centre hinge line of a flip clock -->
    <item android:gravity="center_vertical" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
</layer-list>
