<?xml version="1.0" encoding="utf-8"?>
<!-- Nixie: warm dark wood/bakelite base so the orange cathode glow reads correctly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:startColor="#FF1A1008"
        android:endColor="#FF0A0603"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#66FF8A3D" />
</shape>
