<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. A flat colour is legal, but the launcher parallaxes the background
  independently of the foreground, and a subtle diagonal ramp makes that motion read as depth
  instead of as a sliding grey square. Kept very dark so the neon ring stays the brightest thing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF131B24" />
                <item android:offset="1" android:color="#FF07090C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
