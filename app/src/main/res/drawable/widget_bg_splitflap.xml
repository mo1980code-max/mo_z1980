<?xml version="1.0" encoding="utf-8"?>
<!-- Split-Flap: a dark board with a subtle metal bezel, like an airport departure display. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <gradient
        android:angle="270"
        android:startColor="#FF2A2A2E"
        android:endColor="#FF121214"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#FF4A4A50" />
</shape>
