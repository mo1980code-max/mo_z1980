<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground.

  Geometry is generated, not eyeballed: twelve radial LED-style segments on a 30° pitch, four
  of them long at the quarters, drawn as round-capped strokes. Everything stays inside a 33dp
  radius from the 54,54 centre, i.e. within the 72dp safe zone an adaptive icon guarantees —
  so no launcher mask, circular or squircle, can clip it.

  The hands sit at 10:10, the standard display pose: it is the arrangement that keeps the most
  open space around the centre, which is what makes a clock readable at 48dp.

  The identity is the segmented ring plus the cyan-to-magenta sweep, taken from NeonCyan and
  NeonMagenta in Color.kt, so the icon matches the Cyberpunk style the app is built around
  rather than looking like the stock Material "schedule" glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Quarter markers: longer and heavier, they carry the clock reading at small sizes. -->
    <path
        android:pathData="M54,31L54,21M77,54L87,54M54,77L54,87M31,54L21,54"
        android:strokeWidth="4.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="21" android:startY="21"
                android:endX="87" android:endY="87">
                <item android:offset="0" android:color="#FF00E5FF" />
                <item android:offset="1" android:color="#FFFF2D95" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The eight intermediate ticks, dimmer so the quarters stay dominant. -->
    <path
        android:pathData="M68,29.75L70.5,25.42M78.25,40L82.58,37.5M78.25,68L82.58,70.5M68,78.25L70.5,82.58M40,78.25L37.5,82.58M29.75,68L25.42,70.5M29.75,40L25.42,37.5M40,29.75L37.5,25.42"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeAlpha="0.55">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25" android:startY="25"
                android:endX="83" android:endY="83">
                <item android:offset="0" android:color="#FF00E5FF" />
                <item android:offset="1" android:color="#FFFF2D95" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hour hand: shortest and thickest, white so it never competes with the gradient ring. -->
    <path
        android:pathData="M54,54L40.58,46.25"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Minute hand. -->
    <path
        android:pathData="M54,54L73.05,43"
        android:strokeColor="#FF00E5FF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Pivot. Drawn last so both hands are capped cleanly underneath it. -->
    <path
        android:pathData="M54,50.6A3.4,3.4 0,1 1,53.99 57.4A3.4,3.4 0,0 1,54 50.6z"
        android:fillColor="#FF0B0F14" />
    <path
        android:pathData="M54,52.2A1.8,1.8 0,1 1,53.99 55.8A1.8,1.8 0,0 1,54 52.2z"
        android:fillColor="#FFFF2D95" />
</vector>
