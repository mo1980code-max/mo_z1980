<?xml version="1.0" encoding="utf-8"?>
<!-- LCD: the olive-green backlight of a classic liquid crystal panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <gradient
        android:angle="270"
        android:startColor="#FFB9C98C"
        android:endColor="#FF9CAE72"
        android:type="linear" />
    <stroke
        android:width="2dp"
        android:color="#FF5A6340" />
</shape>
