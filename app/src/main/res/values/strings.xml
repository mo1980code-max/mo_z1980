    <!-- OEM steps -->
    <string name="oem_miui_autostart_title">Enable Autostart</string>
    <string name="oem_miui_autostart_desc">MIUI blocks the alarm from restarting after the phone reboots or the app is swiped away.</string>
    <string name="oem_miui_autostart_steps">Security → Permissions → Autostart → turn ON “Digital Clock Pro”.</string>
    <string name="oem_miui_battery_title">Set battery saver to “No restrictions”</string>
    <string name="oem_miui_battery_desc">MIUI’s own power keeper is separate from Android’s battery optimization.</string>
    <string name="oem_miui_battery_steps">Find “Digital Clock Pro” → Battery saver → choose “No restrictions”.</string>
    <string name="oem_miui_lock_title">Lock the app in Recents</string>
    <string name="oem_miui_lock_desc">Prevents “clear all” from killing the ringing alarm.</string>
    <string name="oem_miui_lock_steps">Open Recents → swipe down on Digital Clock Pro → tap the padlock icon.</string>

    <string name="oem_huawei_startup_title">Manage app launch manually</string>
    <string name="oem_huawei_startup_desc">EMUI closes apps it manages automatically.</string>
    <string name="oem_huawei_startup_steps">App launch → turn OFF “Manage automatically” for Digital Clock Pro → enable all three switches (Auto-launch, Secondary launch, Run in background).</string>
    <string name="oem_huawei_protected_title">Add to protected apps</string>
    <string name="oem_huawei_protected_desc">Keeps the alarm service alive when the screen is off.</string>
    <string name="oem_huawei_protected_steps">Protected apps → enable Digital Clock Pro.</string>

    <string name="oem_samsung_sleeping_title">Remove from “Sleeping apps”</string>
    <string name="oem_samsung_sleeping_desc">One UI puts rarely used apps to sleep, which cancels their alarms.</string>
    <string name="oem_samsung_sleeping_steps">Battery → Background usage limits → make sure Digital Clock Pro is NOT in “Sleeping” or “Deep sleeping” apps.</string>
    <string name="oem_samsung_care_title">Turn off “Put unused apps to sleep”</string>
    <string name="oem_samsung_care_desc">Device Care re-sleeps apps automatically every few days.</string>
    <string name="oem_samsung_care_steps">Device care → Battery → Background usage limits → turn OFF “Put unused apps to sleep”.</string>

    <string name="oem_oppo_startup_title">Allow auto-startup</string>
    <string name="oem_oppo_startup_desc">ColorOS blocks background start after reboot.</string>
    <string name="oem_oppo_startup_steps">Startup manager → enable Digital Clock Pro.</string>
    <string name="oem_oppo_power_title">Disable battery restrictions</string>
    <string name="oem_oppo_power_desc">Set the app to “Allow background running”.</string>
    <string name="oem_oppo_power_steps">Power saver → App battery management → Digital Clock Pro → allow background running + auto-launch.</string>

    <string name="oem_oneplus_chain_title">Allow auto-launch</string>
    <string name="oem_oneplus_chain_desc">OxygenOS “Chain launch” control.</string>
    <string name="oem_oneplus_chain_steps">Auto-launch → enable Digital Clock Pro.</string>
    <string name="oem_oneplus_battery_title">Set battery to “Don’t optimize”</string>
    <string name="oem_oneplus_battery_desc">Advanced optimization also needs to be off.</string>
    <string name="oem_oneplus_battery_steps">Battery → Battery optimization → Digital Clock Pro → Don’t optimize.</string>

    <string name="oem_vivo_bgstart_title">Allow background start-up</string>
    <string name="oem_vivo_bgstart_desc">Funtouch OS blocks background launches by default.</string>
    <string name="oem_vivo_bgstart_steps">Permission manager → Autostart → enable Digital Clock Pro.</string>
    <string name="oem_vivo_whitelist_title">Add to high background power consumption list</string>
    <string name="oem_vivo_whitelist_desc">Stops the system from freezing the alarm service.</string>
    <string name="oem_vivo_whitelist_steps">Battery → High background power consumption → enable Digital Clock Pro.</string>

    <string name="oem_asus_autostart_title">Enable Auto-start</string>
    <string name="oem_asus_autostart_desc">ZenUI Mobile Manager auto-start list.</string>
    <string name="oem_asus_autostart_steps">Mobile Manager → Auto-start manager → allow Digital Clock Pro.</string>

    <string name="oem_letv_autoboot_title">Enable auto-boot</string>
    <string name="oem_letv_autoboot_desc">EUI background app protection.</string>
    <string name="oem_letv_autoboot_steps">Autoboot management → enable Digital Clock Pro.</string>

    <string name="oem_aosp_battery_title">Android battery optimization</string>
    <string name="oem_aosp_battery_desc">The standard exemption every Android version supports.</string>
    <string name="oem_aosp_battery_steps">Choose “All apps” → Digital Clock Pro → Don’t optimize.</string>
    <string name="oem_app_details_title">App info</string>
    <string name="oem_app_details_desc">Manual access to notifications, alarms and battery settings.</string>
    <string name="oem_app_details_steps">Use this if any button above does not open.</string>

