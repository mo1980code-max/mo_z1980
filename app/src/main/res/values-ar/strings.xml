    <!-- خطوات الشركات المصنّعة -->
    <string name="oem_miui_autostart_title">تفعيل التشغيل التلقائي</string>
    <string name="oem_miui_autostart_desc">يمنع نظام MIUI إعادة تشغيل المنبّه بعد إقلاع الهاتف أو بعد إغلاق التطبيق من قائمة التطبيقات الأخيرة.</string>
    <string name="oem_miui_autostart_steps">الأمان ← الأذونات ← التشغيل التلقائي ← فعّل «الساعة الرقمية برو».</string>
    <string name="oem_miui_battery_title">اضبط موفّر البطارية على «بدون قيود»</string>
    <string name="oem_miui_battery_desc">موفّر الطاقة في MIUI مستقل تمامًا عن تحسين البطارية في أندرويد.</string>
    <string name="oem_miui_battery_steps">ابحث عن «الساعة الرقمية برو» ← موفّر البطارية ← اختر «بدون قيود».</string>
    <string name="oem_miui_lock_title">تثبيت التطبيق في التطبيقات الأخيرة</string>
    <string name="oem_miui_lock_desc">يمنع زر «مسح الكل» من إيقاف المنبّه أثناء رنينه.</string>
    <string name="oem_miui_lock_steps">افتح التطبيقات الأخيرة ← اسحب للأسفل على الساعة الرقمية برو ← اضغط رمز القفل.</string>

    <string name="oem_huawei_startup_title">إدارة تشغيل التطبيق يدويًا</string>
    <string name="oem_huawei_startup_desc">يغلق نظام EMUI التطبيقات التي يديرها تلقائيًا.</string>
    <string name="oem_huawei_startup_steps">تشغيل التطبيقات ← أوقف «الإدارة التلقائية» للساعة الرقمية برو ← فعّل المفاتيح الثلاثة (التشغيل التلقائي، التشغيل الثانوي، العمل في الخلفية).</string>
    <string name="oem_huawei_protected_title">الإضافة إلى التطبيقات المحمية</string>
    <string name="oem_huawei_protected_desc">يُبقي خدمة المنبّه تعمل أثناء إطفاء الشاشة.</string>
    <string name="oem_huawei_protected_steps">التطبيقات المحمية ← فعّل الساعة الرقمية برو.</string>

    <string name="oem_samsung_sleeping_title">الإزالة من «التطبيقات النائمة»</string>
    <string name="oem_samsung_sleeping_desc">يُنيم نظام One UI التطبيقات قليلة الاستخدام، وهو ما يلغي منبّهاتها.</string>
    <string name="oem_samsung_sleeping_steps">البطارية ← حدود الاستخدام في الخلفية ← تأكّد أن الساعة الرقمية برو ليست ضمن «التطبيقات النائمة» أو «النائمة بعمق».</string>
    <string name="oem_samsung_care_title">إيقاف «إنامة التطبيقات غير المستخدمة»</string>
    <string name="oem_samsung_care_desc">تعيد «العناية بالجهاز» إنامة التطبيقات تلقائيًا كل بضعة أيام.</string>
    <string name="oem_samsung_care_steps">العناية بالجهاز ← البطارية ← حدود الاستخدام في الخلفية ← أوقف «إنامة التطبيقات غير المستخدمة».</string>

    <string name="oem_oppo_startup_title">السماح بالتشغيل التلقائي</string>
    <string name="oem_oppo_startup_desc">يمنع نظام ColorOS التشغيل في الخلفية بعد إعادة التشغيل.</string>
    <string name="oem_oppo_startup_steps">مدير التشغيل ← فعّل الساعة الرقمية برو.</string>
    <string name="oem_oppo_power_title">تعطيل قيود البطارية</string>
    <string name="oem_oppo_power_desc">اضبط التطبيق على «السماح بالعمل في الخلفية».</string>
    <string name="oem_oppo_power_steps">موفّر الطاقة ← إدارة بطارية التطبيقات ← الساعة الرقمية برو ← اسمح بالعمل في الخلفية والتشغيل التلقائي.</string>

    <string name="oem_oneplus_chain_title">السماح بالتشغيل التلقائي</string>
    <string name="oem_oneplus_chain_desc">خيار «التشغيل المتسلسل» في نظام OxygenOS.</string>
    <string name="oem_oneplus_chain_steps">التشغيل التلقائي ← فعّل الساعة الرقمية برو.</string>
    <string name="oem_oneplus_battery_title">اضبط البطارية على «عدم التحسين»</string>
    <string name="oem_oneplus_battery_desc">يجب أيضًا إيقاف التحسين المتقدّم.</string>
    <string name="oem_oneplus_battery_steps">البطارية ← تحسين البطارية ← الساعة الرقمية برو ← عدم التحسين.</string>

    <string name="oem_vivo_bgstart_title">السماح بالتشغيل في الخلفية</string>
    <string name="oem_vivo_bgstart_desc">يحجب نظام Funtouch OS التشغيل في الخلفية افتراضيًا.</string>
    <string name="oem_vivo_bgstart_steps">مدير الأذونات ← التشغيل التلقائي ← فعّل الساعة الرقمية برو.</string>
    <string name="oem_vivo_whitelist_title">الإضافة إلى قائمة الاستهلاك العالي في الخلفية</string>
